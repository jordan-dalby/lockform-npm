{
  "name": "lockform",
  "version": "4.1.0",
  "description": "Official Lockform SDK: REST API client plus end-to-end encryption (X25519 + AES-256-GCM) for forms, submissions, files, and webhooks.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "derive-key.js"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "pretest": "npm run build",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "preintegration": "npm run build",
    "integration": "node --test \"integration/**/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "derive-key": "node derive-key.js"
  },
  "bin": {
    "lockform-derive-key": "./derive-key.js"
  },
  "keywords": [
    "lockform",
    "encryption",
    "webhook",
    "e2e",
    "forms",
    "x25519",
    "curve25519",
    "aes-gcm",
    "bip39"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0",
    "bip39": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "pg": "^8.11.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
