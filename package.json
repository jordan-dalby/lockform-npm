{
  "name": "lockform",
  "version": "3.0.1",
  "description": "Official SDK for processing Lockform webhook submissions with end-to-end encryption using X25519 + AES-256-GCM",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "derive-key.js"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "derive-key": "node derive-key.js"
  },
  "bin": {
    "lockform-derive-key": "./derive-key.js"
  },
  "keywords": [
    "lockform",
    "encryption",
    "webhook",
    "e2e",
    "forms",
    "x25519",
    "curve25519",
    "aes-gcm",
    "bip39"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0",
    "bip39": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
